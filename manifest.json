{
  "manifest_version": 3,
  "name": "HydraStretch",
  "version": "1.0.0",
  "description": "Pengingat ramah untuk pekerja WFH agar tidak lupa minum air dan meregangkan badan.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HydraStretch Settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
